# Anthropic (chat agent)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_TIMEOUT_SECONDS=120

# Chat limits
CHAT_DAILY_MESSAGE_LIMIT=50
CHAT_CONTEXT_MESSAGES=40

# Database. SQLite for local development:
DATABASE_URL=sqlite:///./coffeemaster.db
# Supabase (PostgreSQL). Use the pooler URI from Supabase > Connect, and keep the
# +psycopg driver prefix, e.g.:
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Per-email limits on verification codes (per user and purpose)
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_PER_HOUR=5

# JWT: generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Email (Gmail SMTP). Confirmation and password-reset emails are sent from your
# own Gmail account. GMAIL_APP_PASSWORD is a Google "app password", not your
# real Gmail password: myaccount.google.com/apppasswords (needs 2-Step
# Verification enabled first).
GMAIL_ADDRESS=tu_correo@gmail.com
GMAIL_APP_PASSWORD=codigo-de-16-caracteres
EMAIL_FROM_NAME=Coffee Master

# Frontend URL used to build links inside emails
FRONTEND_URL=http://localhost:3000

# CORS origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate limits, requests per minute per client IP
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CONVERSATIONS_PER_MINUTE=60

# Send emails after responding. Set to false if codes stop arriving in production.
EMAIL_SEND_IN_BACKGROUND=true
