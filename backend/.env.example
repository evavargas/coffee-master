# Anthropic (chat agent)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Database (SQLite for local development)
DATABASE_URL=sqlite:///./mastercoffee.db

# JWT: generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Email (Resend). Confirmation and password-reset emails are sent from EMAIL_FROM.
RESEND_API_KEY=re_...
EMAIL_FROM=MasterCoffe <onboarding@resend.dev>

# Frontend URL used to build links inside emails
FRONTEND_URL=http://localhost:3000

# CORS origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate limits, requests per minute per client IP
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=20
