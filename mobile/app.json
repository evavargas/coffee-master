{
  "expo": {
    "name": "Coffee Master",
    "slug": "coffee-master",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#faf6f1",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.coffeemaster.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#faf6f1"
        }
      ]
    ]
  }
}
