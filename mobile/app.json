{
  "expo": {
    "name": "Coffee Master",
    "slug": "coffee-master",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#fffff0",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.coffeemaster.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3d2825"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffff0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#2a1a18",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      "expo-router"
    ],
    "scheme": "coffeemaster",
    "icon": "./assets/icon.png"
  }
}
